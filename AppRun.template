#!/bin/bash
# Automatically discover the mounted AppDir directory
APPDIR="$(dirname "$(readlink -f "$0")")"
export RUSTTRACKER_APPDIR="$APPDIR"

# Set library and data search paths so bundled libraries (FFmpeg, libopenmpt, etc.)
# and the SoundFont / hicolor icons can be located while preserving system XDG paths.
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Provision user-level hicolor icon and .desktop entry so SteamOS / Desktop environments
# and Steam's "Add a Non-Steam Game" dialog automatically display the RustTracker icon.
if [ -n "$HOME" ] && [ -f "$APPDIR/usr/share/icons/hicolor/512x512/apps/rusttracker.png" ]; then
    USER_ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/512x512/apps"
    USER_ICON_PATH="$USER_ICON_DIR/rusttracker.png"
    if [ ! -f "$USER_ICON_PATH" ]; then
        mkdir -p "$USER_ICON_DIR" 2>/dev/null || true
        cp "$APPDIR/usr/share/icons/hicolor/512x512/apps/rusttracker.png" "$USER_ICON_PATH" 2>/dev/null || true
    fi
    if [ -n "$APPIMAGE" ]; then
        USER_APPS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
        USER_DESKTOP_PATH="$USER_APPS_DIR/com.soddentrough.rusttracker.desktop"
        mkdir -p "$USER_APPS_DIR" 2>/dev/null || true
        cat > "$USER_DESKTOP_PATH" 2>/dev/null <<EOF || true
[Desktop Entry]
Name=RustTracker
Comment=Hardware-Accelerated Music Module & Media Visualizer
Exec="$APPIMAGE" %U
Icon=$USER_ICON_PATH
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Player;
StartupWMClass=RustTracker
EOF
    fi
fi

# Ensure libxkbcommon always has a valid keyboard layout and config root on SteamOS / minimal WMs
export XKB_DEFAULT_LAYOUT="${XKB_DEFAULT_LAYOUT:-us}"
if [ -z "$XKB_CONFIG_ROOT" ] && [ -d "/usr/share/X11/xkb" ]; then
    export XKB_CONFIG_ROOT="/usr/share/X11/xkb"
fi

# Detect if running under Gamescope / Steam Deck
if [ "$XDG_CURRENT_DESKTOP" = "gamescope" ] || [ "$XDG_SESSION_DESKTOP" = "gamescope" ] || [ -n "$STEAM_DECK" ] || [ -n "$SteamDeck" ] || [ -n "$SteamOS" ]; then
    # Gamescope's XWayland server advertises a 1280x800 screen with 100mm x 150mm physical
    # dimensions (~212 DPI), which causes winit's X11 backend to compute a 2.208x scale factor.
    # Force 1:1 scale factor so the 1280x800 layout renders at native pixel resolution.
    export WINIT_X11_SCALE_FACTOR="${WINIT_X11_SCALE_FACTOR:-1}"
    export RUSTTRACKER_WAYLAND="${RUSTTRACKER_WAYLAND:-1}"
    if [ -n "$WAYLAND_DISPLAY" ]; then
        export WINIT_UNIX_BACKEND="${WINIT_UNIX_BACKEND:-wayland}"
    fi
fi

# Execute the actual binary directly from the mounted AppDir
exec "$APPDIR/usr/bin/rusttracker" "$@"
